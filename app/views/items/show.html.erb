
<div class="app-layout">

  <aside class="sidebar">
    <div class="logo">recs<span>.</span></div>
    <div class="tagline">Good things are worth sharing.</div>

    <div class="nav-section">
      <div class="nav-heading">Discover</div>
      <%= link_to "Home", root_path, class: "nav-link" %>
      <%= link_to "Categories", categories_path, class: "nav-link" %>
      <%= link_to "Friends", friendships_path, class: "nav-link" %>
    </div>

    <% if Current.user&.admin? %>
      <div class="nav-section">
        <div class="nav-heading">Administration</div>
        <%= link_to "Manage Categories",
            admin_categories_path,
            class: "nav-link" %>
      </div>
    <% end %>
  </aside>

  <main class="main-content">

    <div class="breadcrumb">
      <%= link_to "Categories", categories_path %>
      <span> / </span>
      <%= link_to @item.category.name,
          category_path(@item.category.slug) %>
      <span> / </span>
      <%= @item.title %>
    </div>

    <section class="item-header">

      <div class="item-category">
        <%= @item.category.name %>
      </div>

      <h1><%= @item.title %></h1>

      <% if @item.creator.present? %>
        <div class="item-creator">
          <%= @item.creator %>
        </div>
      <% end %>

      <% if @item.description.present? %>
        <p class="item-description">
          <%= @item.description %>
        </p>
      <% end %>

      <% if @item.details.present? %>
        <div class="item-details">
          <% @item.details.each do |key, value| %>
            <% next if value.blank? %>

            <div class="item-detail">
              <span class="detail-label">
                <%= key.to_s.humanize %>
              </span>
              <span><%= value %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="item-header-actions">
        <%= link_to "+ Add Your Review",
            new_review_path(
              category: @item.category.slug,
              recommendation: {
                item_title: @item.title,
                item_creator: @item.creator,
                item_description: @item.description
              }
            ),
            class: "button" %>
      </div>

    </section>

    <section class="item-reviews">

      <div class="category-feed-heading">
        <h2>Reviews from your friends</h2>
        <span><%= pluralize(@reviews.size, "review") %></span>
      </div>

      <% @reviews.each do |review| %>
        <article class="review-card">

          <div class="review-meta">
            <strong><%= review.user.name %></strong>
            recommended this
          </div>

          <div class="review-rating">
            <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
          </div>

          <div class="review-body">
            <%= review.body %>
          </div>

          <div class="review-date">
            <%= review.created_at.strftime("%B %-d, %Y") %>
          </div>

          <% if review.user_id == Current.user.id %>
            <div class="review-actions">
              <%= link_to "Edit your review",
                  edit_review_path(review) %>
            </div>
          <% end %>

        </article>
      <% end %>

    </section>

  </main>
</div>
