
<div class="friends-page">

  <header class="page-header">
    <h1>My Friends</h1>
    <p>Connect with people whose recommendations you trust.</p>
  </header>

  <% if flash[:notice].present? %>
    <div class="notice"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="alert"><%= flash[:alert] %></div>
  <% end %>

  <div class="friends-layout">
    <div class="friends-list-column">

  <section class="friend-section">
    <h2>Friend requests received</h2>

    <% if @received_requests.any? %>
      <% @received_requests.each do |request| %>
        <div class="friend-row">
          <div>
            <strong>
              <%= request.user.name.presence || request.user.email_address %>
            </strong>
            <p>Wants to connect with you</p>
          </div>

          <div class="friend-actions">
            <%= button_to "Accept",
                  friendship_path(request),
                  method: :patch,
                  params: { status: "accepted" } %>

            <%= button_to "Decline",
                  friendship_path(request),
                  method: :patch,
                  params: { status: "declined" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="empty-message">No pending requests.</p>
    <% end %>
  </section>

  <section class="friend-section">
    <h2>Requests sent</h2>

    <% if @sent_requests.any? %>
      <% @sent_requests.each do |request| %>
        <div class="friend-row">
          <div>
            <strong>
              <%= request.friend.name.presence || request.friend.email_address %>
            </strong>
            <p>Waiting for acceptance</p>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="empty-message">You haven't sent any requests.</p>
    <% end %>
  </section>

  <section class="friend-section">
    <h2>My friends</h2>

    <% if @friends.any? %>
      <% @friends.each do |friend| %>
        <div class="friend-row">
          <div>
            <strong>
              <%= friend.name.presence || friend.email_address %>
            </strong>
            <p>Connected</p>
          </div>

          <% friendship = Friendship.find_by(
               user: Current.user, friend: friend, status: "accepted"
             ) ||
             Friendship.find_by(
               user: friend, friend: Current.user, status: "accepted"
             ) %>

          <% if friendship %>
            <%= button_to "Remove friend",
                  friendship_path(friendship),
                  method: :delete,
                  data: { turbo_confirm: "Remove this friend?" } %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="empty-message">
        You haven't connected with anyone yet.
      </p>
    <% end %>
  </section>

    </div>

    <aside class="friends-invite-column">
      <section class="friend-section invite-section">
        <h2>Invite friends</h2>
        <p>Share your recommendations with people you know.</p>

        <div class="recommendation-form-card">
          <%= form_with url: invitations_path, method: :post do |form| %>
            <div class="form-group">
              <%= form.label :email, "Friend's email address" %>
              <%= form.email_field :email,
                  required: true,
                  placeholder: "friend@example.com",
                  class: "form-input" %>
            </div>

            <div class="form-actions">
              <%= form.submit "Send Invitation", class: "button" %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="friend-section invitation-history-section">
        <h2>Invitation History</h2>
        <% if @invitations.any? %>
          <% @invitations.each do |invitation| %>
            <div class="invitation-row">
              <div>
                <strong><%= invitation.email %></strong>
                <p>Sent <%= invitation.created_at.strftime("%b %d, %Y") %></p>
              </div>
              <% if invitation.accepted? %>
                <span class="invitation-status accepted">Accepted</span>
              <% elsif invitation.expired? %>
                <span class="invitation-status expired">Expired</span>
              <% else %>
                <span class="invitation-status pending">Pending</span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="empty-message">You haven't invited anyone yet.</p>
        <% end %>
      </section>
    </aside>
  </div>

</div>
