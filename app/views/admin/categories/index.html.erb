
<div class="admin-container">

  <div class="admin-header">
    <div>
      <h1>Manage Categories</h1>
      <p>Manage the recommendation categories in Recs.</p>
    </div>

    <%= link_to "+ New Category",
        new_admin_category_path,
        class: "button" %>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>Category</th>
        <th>Slug</th>
        <th>Items</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td>
            <strong><%= category.name %></strong>
            <div class="admin-description">
              <%= category.description %>
            </div>
          </td>

          <td><%= category.slug %></td>
          <td><%= category.items_count %></td>

          <td>
            <% if category.active? %>
              <span class="status-active">Active</span>
            <% else %>
              <span class="status-inactive">Inactive</span>
            <% end %>
          </td>

          <td class="admin-actions">
            <%= link_to "Edit",
                edit_admin_category_path(category) %>

            <%= button_to "Delete",
                admin_category_path(category),
                method: :delete,
                form: { data: {
                  turbo_confirm: "Are you sure you want to delete this category?"
                } },
                class: "delete-button" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>
