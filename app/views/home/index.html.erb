<div class="page-header">
  <div>
    <h1>Your recommendations</h1>
    <div class="page-subtitle">
      Discover what your friends are enjoying.
    </div>
  </div>

  <% if @selected_category %>
    <%= link_to "＋ Add recommendation",
        new_review_path(category: @selected_category.slug),
        class: "button" %>
  <% else %>
    <span class="button button-disabled" aria-disabled="true">
      ＋ Add recommendation
    </span>
  <% end %>
</div>

<%= form_with url: root_path, method: :get,
    class: "search-form" do |form| %>
  <%= form.text_field :q,
      value: @query,
      placeholder: "Search recommendations..." %>
  <%= form.submit "Search", class: "button" %>
<% end %>

<div class="category-filters">
  <%= link_to "All",
      root_path,
      class: "category-chip #{'active' if @selected_category.nil?}" %>

  <% @categories.each do |category| %>
    <%= link_to category.name,
        root_path(category: category.slug),
        class: "category-chip #{'active' if @selected_category&.id == category.id}" %>
  <% end %>
</div>

    <div class="review-feed">
      <% @reviews.each do |review| %>
        <article class="review-card">
          <div class="review-meta">
            <%= review.user.name %> recommended
            <%= review.item.category.name.downcase %>
          </div>

          <h3> <%= link_to review.item.title, item_path(review.item) %> </h3>

          <% if review.item.creator.present? %>
            <div class="review-meta">
              <%= review.item.creator %>
            </div>
          <% end %>

          <div class="review-rating">
            <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
          </div>

          <div class="review-body">
            <%= review.body %>
          </div>
        </article>
      <% end %>

      <% if @reviews.empty? %>
        <p>No recommendations yet. Be the first to share one!</p>
      <% end %>
    </div>
