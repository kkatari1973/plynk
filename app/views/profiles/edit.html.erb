
<div class="page-container">
  <div class="page-header">
    <h1>Edit Profile</h1>
    <p>Update your personal information.</p>
  </div>

  <div class="recommendation-form-card">
    <%= form_with model: @user, url: profile_path, method: :patch do |form| %>
      <% if @user.errors.any? %>
        <div class="form-errors">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :name %>
        <%= form.text_field :name, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :email_address, "Email address" %>
        <%= form.email_field :email_address, class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Save Changes", class: "button" %>
        <%= link_to "Cancel", profile_path, class: "button button-secondary" %>
      </div>
    <% end %>
  </div>
</div>
